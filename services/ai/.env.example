# ── AI Providers ───────────────────────────────────────────────────────────────
# Set one or more keys. The router picks the first available in priority order.
# Priority order (default): anthropic > openai > gemini > mistral
# Override with: PROVIDER_PRIORITY=gemini,openai,anthropic,mistral

ANTHROPIC_API_KEY=sk-ant-...        # https://console.anthropic.com/
OPENAI_API_KEY=sk-...               # https://platform.openai.com/
GEMINI_API_KEY=AIza...              # https://aistudio.google.com/
MISTRAL_API_KEY=...                 # https://console.mistral.ai/

# PROVIDER_PRIORITY=anthropic,openai,gemini,mistral

# ── ClickHouse ─────────────────────────────────────────────────────────────────
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=9000
CLICKHOUSE_USER=beacon
CLICKHOUSE_PASSWORD=beacon
CLICKHOUSE_DB=beacon

# ── Cache ──────────────────────────────────────────────────────────────────────
INSIGHTS_CACHE_TTL=1800

# ── Observability ──────────────────────────────────────────────────────────────
OTEL_SERVICE_NAME=beacon-ai

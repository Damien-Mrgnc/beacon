# ─────────────────────────────────────────────
# Beacon — Variables d'environnement globales
# Copier en .env et remplir les valeurs
# ─────────────────────────────────────────────

# ── Kafka ──────────────────────────────────────
# Local : localhost:9092
# AWS MSK : <broker>.kafka.<region>.amazonaws.com:9092
KAFKA_BROKERS=localhost:9092

# ── ClickHouse ─────────────────────────────────
# Local : localhost:8123
# ClickHouse Cloud : <host>.clickhouse.cloud:8443
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=beacon
CLICKHOUSE_PASSWORD=beacon
CLICKHOUSE_DB=beacon

# ── PostgreSQL ─────────────────────────────────
# Local : postgresql://beacon:beacon@localhost:5432/beacon
# AWS Aurora : postgresql://user:pass@<aurora-endpoint>:5432/beacon
DATABASE_URL=postgresql://beacon:beacon@localhost:5432/beacon

# ── Redis ──────────────────────────────────────
# Local : redis://localhost:6379
# AWS ElastiCache : redis://<elasticache-endpoint>:6379
REDIS_URL=redis://localhost:6379

# ── Temporal ───────────────────────────────────
# Local : localhost:7233
# Temporal Cloud : <namespace>.tmprl.cloud:7233
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=beacon

# ── Auth (local dev — pas de Cognito) ──────────
AUTH_MODE=local
JWT_SECRET=dev-secret-change-in-production-minimum-32-chars

# ── AI / Google Gemini ─────────────────────────
# Créer une clé sur https://aistudio.google.com/
GEMINI_API_KEY=AIza...

# Optionnel : Claude Opus pour les analyses batch
# ANTHROPIC_API_KEY=sk-ant-...

# ── Services URLs (local) ──────────────────────
INGESTION_API_URL=http://localhost:8000
AI_SERVICE_URL=http://localhost:8001
TRPC_API_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001
